# Frontend — copy to .env.local for local development with emulators

VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_DATABASE_EMULATOR_PORT=9000
VITE_FIREBASE_STORAGE_EMULATOR_PORT=9199

VITE_API_BASE_URL=/api

VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=namerrs.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=namerrs-default-rtdb
VITE_FIREBASE_PROJECT_ID=namerrs
VITE_FIREBASE_STORAGE_BUCKET=namerrs.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:local

# Stripe publishable test key: https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

VITE_GA_MEASUREMENT_ID=
VITE_SITE_URL=http://localhost:5173