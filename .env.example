# Frontend — .env.local overrides these for your machine (gitignored).
# Default local dev uses the deployed API directly (no Vite proxy).

VITE_USE_FIREBASE_EMULATORS=false

VITE_API_BASE_URL=https://namerrs.web.app/api

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=namerrs.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://namerrs-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=namerrs
VITE_FIREBASE_STORAGE_BUCKET=namerrs.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Stripe publishable test key: https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

VITE_GA_MEASUREMENT_ID=

# Canonical public site URL (sitemap, JSON-LD, Open Graph). Use production domain in deploy.
VITE_SITE_URL=https://namerrs.web.app