{
  "name": "namerrs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-sitemap.js && vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --import=./emulator-data --export-on-exit=./emulator-data",
    "emulators:seed": "node functions/scripts/seed-rtdb.js",
    "emulators:hosting": "npm run build && firebase emulators:start --import=./emulator-data --export-on-exit=./emulator-data",
    "dev:local": "concurrently -k -n vite,emulators -c blue,green \"npm run dev\" \"npm run emulators\"",
    "stripe:listen": "stripe listen --forward-to http://127.0.0.1:5001/namerrs/us-central1/api/webhooks/stripe",
    "dev:full": "concurrently -k -n vite,emulators,stripe -c blue,green,magenta \"npm run dev\" \"npm run emulators\" \"npm run stripe:listen\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-spring/web": "^10.1.2",
    "@reduxjs/toolkit": "^2.2.1",
    "@stripe/react-stripe-js": "^3.1.1",
    "@stripe/stripe-js": "^5.5.0",
    "firebase": "^11.2.0",
    "lucide-react": "^1.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-easy-crop": "^6.0.2",
    "react-redux": "^9.1.0",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@jest/globals": "^29.7.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "babel-jest": "^29.7.0",
    "concurrently": "^9.1.2",
    "firebase-tools": "^13.29.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "sass": "^1.71.1",
    "tailwindcss": "^4.0.0",
    "vite": "^5.1.4"
  }
}
